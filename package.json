{
  "name": "bisharp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "brand:generate": "node scripts/generate-brand.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "contracts:build": "node scripts/forge.mjs build",
    "contracts:test": "node scripts/forge.mjs test -vv",
    "abi": "node scripts/export-abi.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "test:ui": "node --experimental-strip-types --test tests/*.test.ts",
    "demo:local": "node scripts/local-demo.mjs",
    "test:integration": "node scripts/local-demo.mjs --smoke",
    "test:report": "node scripts/test-report.mjs",
    "check:public-build": "node scripts/check-public-build.mjs",
    "verify:routes": "node --experimental-strip-types scripts/verify-route.ts",
    "format": "prettier --write src scripts tests package.json tsconfig.json",
    "format:check": "prettier --check src scripts tests package.json tsconfig.json"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "typescript": "^5.9.0"
  }
}
