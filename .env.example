# Public frontend configuration; set after deploying the contracts.
# Netlify: add the NEXT_PUBLIC_* variables below, scoped to Builds.
# Keep local fixtures disabled on all hosted deployments.
NEXT_PUBLIC_ENABLE_LOCAL=false
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ESCROW_ADDRESS=
# Cross-chain UI: paired, deployed source and destination contracts.
NEXT_PUBLIC_SOURCE_ADDRESS=
NEXT_PUBLIC_DESTINATION_ADDRESS=
NEXT_PUBLIC_OP_RPC_URL=https://sepolia.optimism.io
NEXT_PUBLIC_SOLVER_ADDRESS=
# Optional multi-route array. IDs must be unique; only distinct supported testnets.
# NEXT_PUBLIC_ROUTES_JSON=[{"id":"eth-op","sourceChainId":11155111,"destinationChainId":11155420,"escrow":"0x...","executor":"0x..."}]
# Additional supported presets (deployments and lane verification still required):
NEXT_PUBLIC_ARB_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org

# Foundry only: the variables below are NOT needed in Netlify.
# An optional SEPOLIA_PRIVATE_KEY in Git-ignored .env is supported
# for a disposable testnet wallet. Never prefix a private key with NEXT_PUBLIC_.
# Without SEPOLIA_PRIVATE_KEY, use an encrypted Foundry keystore with --account.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Funded destination for the planned cross-chain implementation (chain 11155420).
OP_SEPOLIA_RPC_URL=https://sepolia.optimism.io
# Candidate Chainlink ETH/USD proxy; verify code/feed on your RPC before deployment.
PRICE_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306
MAX_PRICE_AGE=3600
